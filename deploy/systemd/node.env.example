# /etc/yurirtc/node.env — chmod 600, owned by the yurirtc user.
# Referenced by content-node.service. Never commit the real file.
# Legacy EDUROCKS_* names remain supported when the corresponding YURIRTC_*
# value is absent, so existing deployments can migrate incrementally.

# Public IPv4 advertised in ICE candidates. Must be the address clients reach,
# not whatever the box enumerates locally.
YURIRTC_PUBLIC_IP=203.0.113.10
# Bind only the content-node IP on a multi-address host, never 0.0.0.0.
YURIRTC_BIND_IP=203.0.113.10
# ICE advertises every port over both UDP and TCP and uses whichever pair
# works. List them least to most likely to be filtered: every host candidate on
# one address carries the same ICE priority whatever its port, so this order is
# what decides which the browser tries first. The default leads with the web's
# own ports, then the push ports that managed Chromebook and iPad fleets must
# already permit, then DNS and NTP, and finally the ephemeral-range fallback.
# Each port costs two listening sockets and four more candidates per offer.
YURIRTC_PORTS=443,80,5228,5229,5230,5223,2197,53,123,49152,445

YURIRTC_PROJECT=your-firebase-project

# Copy the exact Realtime Database URL from Firebase. Depending on its location,
# it can use either the firebaseio.com or firebasedatabase.app hostname form.
YURIRTC_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com

# Service-account credentials cover both signaling backends. The standard
# Google variable remains supported, as do YURIRTC_CREDENTIALS and its legacy
# alias; using the Google name also makes other Google tooling work unchanged.
GOOGLE_APPLICATION_CREDENTIALS=/etc/yurirtc/service-account.json
