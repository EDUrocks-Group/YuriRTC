# Never commit credentials — one service account covers both signaling legs.
# Firebase's generated admin credential filenames do not follow one stable
# shape. Keep the patterns broad so a new project cannot leak its key.
service-account.json
*-credentials.json
*adminsdk*.json
*serviceaccount*.json
*.pem
*.key
node.env

# firebase-tools writes deploy caches here
deploy/firebase/.firebase/

