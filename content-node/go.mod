module yurirtc/content-node

go 1.25.13

// YuriRTC carries a small, auditable SCTP transport fork for CUBIC congestion
// control, RFC 7053 Immediate-SACK signaling, and direct DATA serialization.
// DTLS and packet-context forks remove per-packet copies and watcher goroutines;
// exact upstream versions, patch scope, and validation are in each YURIRTC.md.
replace github.com/pion/sctp => ../third_party/pion-sctp

replace github.com/pion/dtls/v3 => ../third_party/pion-dtls

replace github.com/pion/transport/v4 => ../third_party/pion-transport

require (
	cloud.google.com/go/firestore v1.21.0
	firebase.google.com/go/v4 v4.14.1
